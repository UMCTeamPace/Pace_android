<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:gravity="center"
                android:width="18dp"
                android:height="18dp">
                <shape android:shape="oval">
                    <stroke
                        android:width="2dp"
                        android:color="@color/semantic_info" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item
                android:gravity="center"
                android:width="12dp"
                android:height="12dp">
                <shape android:shape="oval">
                    <solid android:color="@color/semantic_info" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:gravity="center"
                android:width="18dp"
                android:height="18dp">
            <shape android:shape="oval">
                <size
                    android:width="18dp"
                    android:height="18dp" />
                <stroke
                    android:width="2dp"
                    android:color="@color/text_disabled" />
                <solid android:color="@android:color/transparent" />
            </shape>
            </item>
        </layer-list>
    </item>
</selector>
