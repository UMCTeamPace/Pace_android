<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="oval">
                    <stroke
                        android:width="2dp"
                        android:color="@color/semantic_info" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp">
                <shape android:shape="oval">
                    <solid android:color="@color/semantic_info" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="oval">
                    <stroke
                        android:width="2dp"
                        android:color="@color/text_disabled" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
