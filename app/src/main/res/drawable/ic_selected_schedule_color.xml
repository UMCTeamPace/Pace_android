<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/schedule_color_bg" android:gravity="center">
        <shape
            android:shape="oval">
            <size android:width="24dp" android:height="24dp"/>
            <solid android:color="@color/primary_500"/>
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp"
        android:gravity="center">
        <shape
            android:shape="oval">
            <size android:width="20dp" android:height="20dp"/>
            <solid android:color="@color/white"/>
        </shape>
    </item>
    <item android:id="@+id/schedule_color_front"
        android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp"
        android:gravity="center">
        <shape
            android:shape="oval">
            <size android:width="16dp" android:height="16dp"/>
            <solid android:color="@color/primary_500"/>
        </shape>
    </item>
</layer-list>
