<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/item_route_detail_walk_start_tv"
        android:layout_width="36dp"
        android:layout_height="18dp"
        android:text="11:04"
        android:textAppearance="@style/TextAppearance.App.CaptionMd.Semibold"
        style="@style/TextColor.Secondary"
        android:background="@drawable/bg_item_route_detail"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:gravity="center"
        android:layout_marginTop="7dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/item_route_detail_walk_iv"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_people"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/item_route_detail_walk_start_tv"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dot_line"
        android:rotation="90"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@id/item_route_detail_walk_iv"
        app:layout_constraintStart_toStartOf="@id/item_route_detail_walk_iv"
        app:layout_constraintEnd_toEndOf="@id/item_route_detail_walk_iv"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/item_route_detail_walk_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="서초역 1번 출구 하차"
        android:textAppearance="@style/TextAppearance.App.BodySm.Semibold"
        style="@style/TextColor.Primary"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/item_route_detail_walk_iv"/>
    <TextView
        android:id="@+id/item_route_detail_walk_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3분 도보"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
        style="@style/TextColor.Secondary"
        android:paddingBottom="17dp"
        android:layout_marginTop="16.78dp"
        app:layout_constraintTop_toBottomOf="@id/item_route_detail_walk_tv"
        app:layout_constraintStart_toStartOf="@id/item_route_detail_walk_tv"/>
    <TextView
        android:id="@+id/item_route_detail_walk_distance_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="143M 이동"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
        style="@style/TextColor.Tertiary"
        android:paddingBottom="17dp"
        android:layout_marginTop="16.78dp"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toBottomOf="@id/item_route_detail_walk_tv"
        app:layout_constraintStart_toEndOf="@id/item_route_detail_walk_time_tv"/>

</androidx.constraintlayout.widget.ConstraintLayout>