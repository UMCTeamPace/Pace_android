<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <View
        android:id="@+id/centerLine"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="@color/primary_400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>

    <ImageView
        android:id="@+id/ic_subway"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:src="@drawable/ic_onboarding_subway"
        app:layout_constraintBottom_toTopOf="@+id/centerLine"
        app:layout_constraintEnd_toStartOf="@+id/ic_pin_calendar"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ic_pin_calendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="-10.5dp"
        android:src="@drawable/ic_onboarding_pin_calendar"
        app:layout_constraintBottom_toTopOf="@+id/centerLine"
        app:layout_constraintEnd_toStartOf="@+id/ic_bus"
        app:layout_constraintStart_toEndOf="@+id/ic_subway" />

    <ImageView
        android:id="@+id/ic_bus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_onboarding_bus"
        app:layout_constraintBottom_toTopOf="@+id/centerLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ic_pin_calendar" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        tools:text="하루의 일정과 이동 사이에서 \n당신의 페이스는 어땠나요?"
        android:textAppearance="@style/TextAppearance.App.BodyMd.Regular"
        android:textColor="@color/text_primary"
        android:lineSpacingExtra="4dp"
        android:alpha="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/centerLine" />

</androidx.constraintlayout.widget.ConstraintLayout>
