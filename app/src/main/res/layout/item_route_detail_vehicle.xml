<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">
    <ImageView
        android:id="@+id/item_route_detail_vehicle_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_route_detail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/route_metropolitan_bus"
        app:layout_constraintTop_toBottomOf="@id/item_route_detail_vehicle_iv"
        app:layout_constraintStart_toStartOf="@id/item_route_detail_vehicle_iv"
        app:layout_constraintEnd_toEndOf="@id/item_route_detail_vehicle_iv"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/item_route_detail_vehicle_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="한양대학교 컨벤션 센터 승차"
        android:textAppearance="@style/TextAppearance.App.BodySm.Semibold"
        style="@style/TextColor.Primary"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/item_route_detail_vehicle_iv"/>
    <LinearLayout
        android:id="@+id/item_route_detail_vehicle_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_marginTop="16.49dp"
        android:background="@drawable/bg_route_detail_vehicle"
        app:layout_constraintTop_toBottomOf="@id/item_route_detail_vehicle_tv"
        app:layout_constraintStart_toStartOf="@id/item_route_detail_vehicle_tv"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/item_route_detail_vehicle_line_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3102"
            android:textAppearance="@style/TextAppearance.App.CaptionLg.Semibold"/>
        <TextView
            android:id="@+id/item_route_detail_vehicle_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11:10"
            android:textAppearance="@style/TextAppearance.App.CaptionLg.Semibold"
            android:layout_marginStart="16dp"/>
        <TextView
            android:id="@+id/item_route_detail_vehicle_direction_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="성안길 입구 방변"
            android:textAppearance="@style/TextAppearance.App.CaptionLg.Semibold"
            style="@style/TextColor.Tertiary"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/item_route_detail_vehicle_stations_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8개 정류장 이동"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
        style="@style/TextColor.Tertiary"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/item_route_detail_vehicle_ll"
        app:layout_constraintStart_toStartOf="@id/item_route_detail_vehicle_ll"/>
    <TextView
        android:id="@+id/item_route_detail_vehicle_stations_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="55분"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
        style="@style/TextColor.Secondary"
        android:layout_marginTop="12dp"
        android:layout_marginStart="3dp"
        app:layout_constraintTop_toBottomOf="@id/item_route_detail_vehicle_ll"
        app:layout_constraintStart_toEndOf="@id/item_route_detail_vehicle_stations_tv"/>
    <ImageView
        android:id="@+id/item_route_detail_vehicle_arrow_down_iv"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_arrow_down"
        android:clickable="true"
        android:layout_marginTop="15dp"
        android:layout_marginStart="3dp"
        app:layout_constraintTop_toBottomOf="@id/item_route_detail_vehicle_ll"
        app:layout_constraintStart_toEndOf="@id/item_route_detail_vehicle_stations_time_tv"/>

</androidx.constraintlayout.widget.ConstraintLayout>