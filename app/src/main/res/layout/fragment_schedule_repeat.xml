<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:clickable="true"      android:focusable="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/repeat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="@drawable/ic_arrow_opened"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="반복"
            android:textAppearance="@style/TextAppearance.App.HeadlineSm"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/repeat_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_repeat_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="일정 반복을 진행하지 않습니다."
                android:textAppearance="@style/TextAppearance.App.BodySm.Semibold"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/box_schedule"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <RadioGroup
                    android:id="@+id/rg_repeat_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/rb_none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="안함"
                        android:button="@null"
                        android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                        android:paddingEnd="16dp"
                        android:drawableTint="@color/selector_radio_button"
                        android:drawableTintMode="src_in"
                        android:background="@null"
                        android:backgroundTint="@android:color/transparent"
                        android:checked="true"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <RadioButton
                        android:id="@+id/rb_daily"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="일간"
                        android:button="@null"
                        android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                        android:paddingEnd="16dp"
                        android:drawableTint="@color/selector_radio_button"
                        android:background="@null"
                        android:backgroundTint="@android:color/transparent"
                        android:drawableTintMode="src_in" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <RadioButton
                        android:id="@+id/rb_week"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="주간"
                        android:button="@null"
                        android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                        android:paddingEnd="16dp"
                        android:drawableTint="@color/selector_radio_button"
                        android:background="@null"
                        android:backgroundTint="@android:color/transparent"
                        android:drawableTintMode="src_in" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <RadioButton
                        android:id="@+id/rb_month"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="월간"
                        android:button="@null"
                        android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                        android:paddingEnd="16dp"
                        android:drawableTint="@color/selector_radio_button"
                        android:background="@null"
                        android:backgroundTint="@android:color/transparent"
                        android:drawableTintMode="src_in" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <RadioButton
                        android:id="@+id/rb_year"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="연간"
                        android:button="@null"
                        android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                        android:paddingEnd="16dp"
                        android:drawableTint="@color/selector_radio_button"
                        android:background="@null"
                        android:backgroundTint="@android:color/transparent"
                        android:drawableTintMode="src_in" />
                </RadioGroup>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/layout_repeat_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="반복 주기"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">

                        <EditText
                            android:id="@+id/et_interval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#888888"
                            android:backgroundTintMode="src_in"
                            android:inputType="number"
                            android:text="1"
                            android:minWidth="30dp"
                            android:textAlignment="center"
                            android:selectAllOnFocus="true"/>

                        <TextView
                            android:id="@+id/tv_interval_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="일마다"
                            android:textColor="@color/black" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/layout_day_of_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/cb_sun"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:button="@null"
                    android:background="@drawable/btn_day_button"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="일"
                    android:gravity="center"
                    android:textColor="@color/semantic_warning" />

                <CheckBox
                    android:id="@+id/cb_mon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:background="@drawable/btn_day_button"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="월"
                    android:gravity="center"
                    android:textColor="@color/selector_day_text" />

                <CheckBox
                    android:id="@+id/cb_tue"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:background="@drawable/btn_day_button"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="화"
                    android:gravity="center"
                    android:textColor="@color/selector_day_text" />

                <CheckBox
                    android:id="@+id/cb_wed"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:background="@drawable/btn_day_button"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="수"
                    android:gravity="center"
                    android:textColor="@color/selector_day_text" />

                <CheckBox
                    android:id="@+id/cb_thu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:background="@drawable/btn_day_button"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="목"
                    android:gravity="center"
                    android:textColor="@color/selector_day_text" />

                <CheckBox
                    android:id="@+id/cb_fri"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:background="@drawable/btn_day_button"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="금"
                    android:gravity="center"
                    android:textColor="@color/selector_day_text" />

                <CheckBox
                    android:id="@+id/cb_sat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:background="@drawable/btn_day_button"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="토"
                    android:gravity="center"
                    android:textColor="@color/semantic_success" />
            </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_repeat_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="반복 종료"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/box_schedule"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <RadioGroup
                        android:id="@+id/rg_end_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <RadioButton
                            android:id="@+id/rb_end_never"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:text="계속 진행"
                            android:button="@null"
                            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                            android:paddingEnd="16dp"
                            android:drawableTint="@color/selector_radio_button"
                            android:drawableTintMode="src_in"
                            android:background="@null"
                            android:backgroundTint="@android:color/transparent"
                            android:checked="true"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F3F5" />

                        <RadioButton
                            android:id="@+id/rb_end_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:text="횟수 지정"
                            android:button="@null"
                            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                            android:paddingEnd="16dp"
                            android:drawableTint="@color/selector_radio_button"
                            android:background="@null"
                            android:backgroundTint="@android:color/transparent"
                            android:drawableTintMode="src_in" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F3F5" />

                        <RadioButton
                            android:id="@+id/rb_end_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:text="종료 날짜"
                            android:button="@null"
                            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                            android:paddingEnd="16dp"
                            android:drawableTint="@color/selector_radio_button"
                            android:background="@null"
                            android:backgroundTint="@android:color/transparent"
                            android:drawableTintMode="src_in" />
                    </RadioGroup>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>