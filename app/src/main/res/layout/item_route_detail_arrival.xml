<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/item_route_detail_arrival_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11:04"
        android:textAppearance="@style/TextAppearance.App.CaptionMd.Semibold"
        style="@style/TextColor.Secondary"
        android:background="@drawable/bg_item_route_detail"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/item_route_detail_arrival_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_route_selected"
        android:background="@drawable/bg_item_route_detail_arrival"
        android:padding="0.77dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/item_route_detail_arrival_time_tv"/>
    <TextView
        android:id="@+id/item_route_detail_arrival_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="경성미술관"
        android:textAppearance="@style/TextAppearance.App.BodySm.Semibold"
        style="@style/TextColor.Primary"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/item_route_detail_arrival_iv"/>

</androidx.constraintlayout.widget.ConstraintLayout>