<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_repeat_interval"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="반복 주기"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/et_week_interval"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@null"
                            android:gravity="center"
                            android:hint="1"
                            android:inputType="number"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:selectAllOnFocus="false"
                            android:text="1"
                            android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                            android:textColor="@color/black"
                            android:textColorHighlight="@android:color/transparent"
                            android:textCursorDrawable="@null" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="0dp"
                            android:background="@color/black" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_week_interval_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="주마다"
                        android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                        android:textColor="@color/black" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_day_of_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="13dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/cb_sun"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_repeat_weekday"
                    android:paddingHorizontal="6dp"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="일"
                    android:gravity="center"
                    android:textColor="@color/selector_repeat_weekday_weekend_sun" />

                <CheckBox
                    android:id="@+id/cb_mon"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_repeat_weekday"
                    android:paddingHorizontal="6dp"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="월"
                    android:gravity="center"
                    android:textColor="@color/selector_repeat_weekday_text" />

                <CheckBox
                    android:id="@+id/cb_tue"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_repeat_weekday"
                    android:paddingHorizontal="6dp"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="화"
                    android:gravity="center"
                    android:textColor="@color/selector_repeat_weekday_text" />

                <CheckBox
                    android:id="@+id/cb_wed"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_repeat_weekday"
                    android:paddingHorizontal="6dp"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="수"
                    android:gravity="center"
                    android:textColor="@color/selector_repeat_weekday_text" />

                <CheckBox
                    android:id="@+id/cb_thu"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_repeat_weekday"
                    android:paddingHorizontal="6dp"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="목"
                    android:gravity="center"
                    android:textColor="@color/selector_repeat_weekday_text" />

                <CheckBox
                    android:id="@+id/cb_fri"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_repeat_weekday"
                    android:paddingHorizontal="6dp"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="금"
                    android:gravity="center"
                    android:textColor="@color/selector_repeat_weekday_text" />

                <CheckBox
                    android:id="@+id/cb_sat"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_repeat_weekday"
                    android:paddingHorizontal="6dp"
                    style="@style/TextAppearance.App.CaptionMd.Medium"
                    android:text="토"
                    android:gravity="center"
                    android:textColor="@color/selector_repeat_weekday_weekend_sat" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
