<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="출발 알림을 언제 보내 드릴까요?"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_description"
        app:layout_constraintBottom_toTopOf="@id/tv_alarm_description">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/box_schedule"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_description">

        <LinearLayout
            android:id="@+id/layout_checkbox_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <CheckBox
                android:id="@+id/rb_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="안함"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_departure_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 시각"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start5mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 5분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start10mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 10분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start15mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 15분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start20mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 20분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start25mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 25분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start30mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 30분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start35mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 35분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start45mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 45분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start50mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 50분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />
            <CheckBox
                android:id="@+id/rb_start55mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 55분 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />

            <CheckBox
                android:id="@+id/rb_start1hago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="출발 1시간 전"
                android:button="@null"
                android:drawableEnd="@drawable/selector_circle_checkbox"
                android:paddingEnd="16dp"
                android:background="@null" />

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F3F5" />


        </LinearLayout>
    </androidx.cardview.widget.CardView>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/tv_alarm_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="25dp"
        android:text="*알림은 총 5개 까지 설정할 수 있습니다."
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.App.BodySm.Semibold"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/btn_white_round"
        android:text="다음"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>