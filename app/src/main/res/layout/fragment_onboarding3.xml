<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="24dp">

    <View
        android:id="@+id/centerLine"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#D4E157"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <ImageView
        android:id="@+id/ic_calendar"
        android:layout_width="60dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_onboarding_calendar"
        android:layout_marginStart="79dp"
        app:layout_constraintBottom_toTopOf="@+id/centerLine"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-8dp" />

    <View
        android:id="@+id/line_top"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#D4E157"
        app:layout_constraintBottom_toTopOf="@+id/line_mid"
        android:layout_marginBottom="80dp"/>

    <ImageView
        android:id="@+id/ic_map"
        android:layout_width="60dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_onboarding_map_pin"
        app:layout_constraintBottom_toTopOf="@+id/line_mid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-8dp"/>

    <View
        android:id="@+id/line_mid"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#D4E157"
        app:layout_constraintBottom_toTopOf="@+id/centerLine"
        android:layout_marginBottom="80dp"/>

    <ImageView
        android:id="@+id/ic_clock"
        android:layout_width="60dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_onboarding_clock"
        android:layout_marginEnd="77dp"
        app:layout_constraintBottom_toTopOf="@+id/line_top"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-8dp"/>

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        tools:text="일정은 캘린더로, 경로는 지도로\n출발 타이밍까지 신경 쓰다 보면\n하루의 흐름과 내 페이스를 놓치곤 해요."
        android:lineSpacingExtra="4dp"
        android:alpha="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/centerLine" />

</androidx.constraintlayout.widget.ConstraintLayout>