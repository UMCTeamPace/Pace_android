<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/setting_box"
    android:paddingTop="16dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp"
    android:layout_marginTop="20dp"
    android:layout_marginStart="18dp"
    android:layout_marginEnd="18dp">
    <TextView
        android:id="@+id/default_calendar_my_phone_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="내 휴대전화"
        android:textAppearance="@style/TextAppearance.App.Num.CaptionLg.Regular"
        style="@style/TextColor.Setting"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/default_calendar_my_phone_iv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:id="@+id/default_calendar_my_phone_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_100"
        android:layout_marginTop="16.5dp"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_my_phone_tv"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/default_calendar_google1_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Google"
        android:textAppearance="@style/TextAppearance.App.Num.CaptionLg.Regular"
        style="@style/TextColor.Setting"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_my_phone_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/default_calendar_google1_email_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pace@gmail.com"
        android:textAppearance="@style/TextAppearance.App.Num.CaptionMd.Regular"
        style="@style/TextColor.Setting"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_google1_tv"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:visibility="gone"
        android:id="@+id/default_calendar_google1_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_my_phone_view"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:id="@+id/default_calendar_google1_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_100"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_google1_email_tv"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/default_calendar_google2_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Google"
        android:textAppearance="@style/TextAppearance.App.Num.CaptionLg.Regular"
        style="@style/TextColor.Setting"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_google1_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/default_calendar_google2_email_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pace2@gmail.com"
        android:textAppearance="@style/TextAppearance.App.Num.CaptionMd.Regular"
        style="@style/TextColor.Setting"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_google2_tv"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/default_calendar_google2_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_google1_view"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:id="@+id/default_calendar_google2_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_100"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_google2_email_tv"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/default_calendar_samsung_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Samsung"
        android:textAppearance="@style/TextAppearance.App.Num.CaptionLg.Regular"
        style="@style/TextColor.Setting"
        android:layout_marginTop="16.5dp"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_google2_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:visibility="gone"
        android:id="@+id/default_calendar_samsung_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/default_calendar_google2_view"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>