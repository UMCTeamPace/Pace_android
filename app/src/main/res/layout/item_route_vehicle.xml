<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:layout_marginBottom="8dp">
    <ImageView
        android:id="@+id/item_route_vehicle_iv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_route_detail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/item_route_vehicle_view"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/gray_400"
        app:layout_constraintTop_toBottomOf="@id/item_route_vehicle_iv"
        app:layout_constraintStart_toStartOf="@id/item_route_vehicle_iv"
        app:layout_constraintEnd_toEndOf="@id/item_route_vehicle_iv"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/item_route_vehicle_line_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3103"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Semibold"
        android:textColor="@color/route_metropolitan_bus"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/item_route_vehicle_iv"/>
    <TextView
        android:id="@+id/item_route_vehicle_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="한양대정문"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Semibold"
        style="@style/TextColor.Secondary"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/item_route_vehicle_line_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>