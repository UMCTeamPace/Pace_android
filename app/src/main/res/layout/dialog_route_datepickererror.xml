<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="156dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/box_dialog">

    <LinearLayout
        android:id="@+id/datepierror_tv_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="30dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="경로 일정 기간이 30일을 초과했습니다."
            android:textAppearance="@style/TextAppearance.App.Num.BodyMd.Medium"
            style="@style/TextColor.Setting"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일정 기간을 확인해주세요."
            android:textAppearance="@style/TextAppearance.App.Num.CaptionLg.Regular"
            style="@style/TextColor.Setting"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="23dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintTop_toBottomOf="@id/datepierror_tv_ll"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/signout_cancel_btn"
            android:layout_width="122dp"
            android:layout_height="38dp"
            android:text="취소"
            android:layout_marginEnd="11dp"
            android:background="@drawable/btn_dialog"
            android:stateListAnimator="@null"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/signout_confirm_btn"
            android:layout_width="122dp"
            android:layout_height="38dp"
            android:text="확인"
            android:layout_marginEnd="11dp"
            android:background="@drawable/btn_dialog"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>