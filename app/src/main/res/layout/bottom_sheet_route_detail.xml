<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_rounded"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/route_detail_time_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:id="@+id/route_detail_departure_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textAppearance="@style/TextAppearance.App.HeadlineMd"
                    style="@style/TextColor.Primary" />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_indicate_unselected" />
                <TextView
                    android:id="@+id/route_detail_arrival_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textAppearance="@style/TextAppearance.App.HeadlineMd"
                    style="@style/TextColor.Primary" />
            </LinearLayout>
            <TextView
                android:id="@+id/route_detail_total_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="총 00분 소요"
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Medium"
                style="@style/TextColor.Secondary"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/route_detail_time_ll"/>
            <LinearLayout
                android:id="@+id/route_detail_brief_ll"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/bg_item_route_detail_brief"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/route_detail_total_tv"/>
            <LinearLayout
                android:id="@+id/route_detail_expanded_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/route_detail_brief_ll"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="경로 선택"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Semibold"
        style="@style/TextColor.White"
        android:background="@drawable/btn_route_green"
        android:stateListAnimator="@null"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>