<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="20dp">

    <ImageView
        android:id="@+id/iv_group_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:src="@drawable/ic_favorites"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_group_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/pretendard_medium"
        android:text="내 장소"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_group_icon"
        app:layout_constraintEnd_toStartOf="@id/tv_place_count"
        app:layout_constraintStart_toEndOf="@+id/iv_group_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_group_icon" />

    <TextView
        android:id="@+id/tv_place_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="0"
        android:textColor="@color/gray_500"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_group_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_group_icon" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_100"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_group_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>