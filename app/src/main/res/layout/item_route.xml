<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:background="@color/white">
    <LinearLayout
        android:id="@+id/route_time_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/route_departure_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textAppearance="@style/TextAppearance.App.HeadlineMd"
            style="@style/TextColor.Primary" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_indicate_unselected" />
        <TextView
            android:id="@+id/route_arrival_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textAppearance="@style/TextAppearance.App.HeadlineMd"
            style="@style/TextColor.Primary" />
    </LinearLayout>
    <TextView
        android:id="@+id/route_total_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="총 00분 소요"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Medium"
        style="@style/TextColor.Secondary"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/route_time_ll"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_item_route_detail_brief"
        app:layout_constraintTop_toBottomOf="@id/route_total_tv"/>
    <LinearLayout
        android:id="@+id/route_brief_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/route_total_tv"/>
    <LinearLayout
        android:id="@+id/route_vehicle_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/route_brief_ll"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/route_detail_select_btn"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="경로 선택"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
        style="@style/TextColor.Secondary"
        android:background="@drawable/btn_route_white"
        android:stateListAnimator="@null"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/route_vehicle_ll"/>
</androidx.constraintlayout.widget.ConstraintLayout>