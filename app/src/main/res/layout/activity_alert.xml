<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAEF"
    android:fitsSystemWindows="true"
    tools:context=".AlertActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutNormal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/layoutWeatherChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:background="@drawable/bg_weather_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivWeatherIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/gray_0" />

            <TextView
                android:id="@+id/tvWeatherInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="서울 · 맑음 · 23°"
                android:textAppearance="@style/TextAppearance.App.BodySm.Semibold"
                android:textColor="@color/gray_0" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCharacter"
            android:layout_width="0dp"
            android:layout_height="273dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toTopOf="@+id/tvSubMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutWeatherChip"
            tools:src="@drawable/img_get_started" />

        <TextView
            android:id="@+id/tvSubMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="슬슬 준비를 시작하면 좋아요!"
            android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
            android:textColor="@color/text_secondary"
            app:layout_constraintBottom_toTopOf="@+id/tvMainMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvMainMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:text="출발까지 1시간 남았어요."
            android:textAppearance="@style/TextAppearance.App.HeadlineSm"
            android:textColor="@color/text_primary"
            app:layout_constraintBottom_toTopOf="@+id/btnClose"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClose"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:layout_marginBottom="57dp"
            android:background="@drawable/bg_alarm_close_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="알림 끄기"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.App.BodyMd.SemiBold"
            android:textColor="@color/gray_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutOffline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/layoutOfflineWeatherChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:background="@drawable/bg_weather_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivOfflineWeatherIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/gray_0" />

            <TextView
                android:id="@+id/tvOfflineWeatherInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오프라인 모드"
                android:textAppearance="@style/TextAppearance.App.BodySm.Semibold"
                android:textColor="@color/gray_0" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivOfflineCharacter"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toTopOf="@+id/tvOfflineSubMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutOfflineWeatherChip"
            tools:src="@drawable/img_shower" />

        <TextView
            android:id="@+id/tvOfflineSubMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="인터넷 연결은 없지만"
            android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
            android:textColor="@color/text_secondary"
            app:layout_constraintBottom_toTopOf="@+id/tvOfflineMainMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvOfflineMainMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:text="출발 시간을 확인해 주세요."
            android:textAppearance="@style/TextAppearance.App.HeadlineSm"
            android:textColor="@color/text_primary"
            app:layout_constraintBottom_toTopOf="@+id/btnOfflineClose"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOfflineClose"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:layout_marginBottom="57dp"
            android:background="@drawable/bg_alarm_close_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="알림 끄기"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.App.BodyMd.SemiBold"
            android:textColor="@color/gray_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
