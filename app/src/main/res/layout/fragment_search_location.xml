<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <HorizontalScrollView
        android:id="@+id/search_chip_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recent_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근검색"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"
                android:checked="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recent_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근장소"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recent_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근경로"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_saved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저장됨"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_route_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="경로히스토리"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_location_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/search_chip_scroll_view"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>