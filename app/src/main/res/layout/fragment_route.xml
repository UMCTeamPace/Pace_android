<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/route_map_fcv"
            android:name="com.example.pace.ui.search_box.MapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <FrameLayout
            android:id="@+id/route_search_fcv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            android:visibility="gone"
            android:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/layout_route_header_container"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/layout_no_search_result"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            android:src="@drawable/ic_no_result"
            android:visibility="gone"
            android:elevation="0dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/route_search_fcv"
            app:layout_constraintBottom_toBottomOf="@id/route_search_fcv"
            app:layout_constraintStart_toStartOf="@id/route_search_fcv"
            app:layout_constraintEnd_toEndOf="@id/route_search_fcv"/>

        <LinearLayout
            android:id="@+id/layout_route_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <include
                android:id="@+id/layout_route_input_header"
                layout="@layout/layout_route_search_header"
                android:visibility="gone" />

            <include
                android:id="@+id/layout_bookmark_header"
                layout="@layout/layout_bookmark_header"
                android:visibility="gone" />
        </LinearLayout>

        <include
            android:id="@+id/layout_map_select_overlay"
            layout="@layout/layout_route_map_selection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <include
            android:id="@+id/layout_route_detail_overlay"
            layout="@layout/layout_route_detail_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/bottom_sheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        style="@style/Widget.Design.BottomSheet.Modal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>