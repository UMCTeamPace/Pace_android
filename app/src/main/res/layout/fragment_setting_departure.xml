<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:clickable="true"      android:focusable="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/box_schedule"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/layout_checkbox_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <CheckBox
                        android:id="@+id/rb_none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="안함"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_starttime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 시각"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start5mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 5분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start10mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 10분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start15mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 15분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start20mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 20분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start25mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 25분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start30mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 30분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start35mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 35분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <CheckBox
                        android:id="@+id/rb_start40mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 40분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start45mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 45분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start50mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 50분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start55mago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 55분 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F3F5" />

                    <CheckBox
                        android:id="@+id/rb_start1hago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="출발 1시간 전"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_circle_checkbox_18"
                        android:paddingEnd="16dp"
                        android:background="@null" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_alarm_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="*알림은 총 5개 까지 설정할 수 있습니다."
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.BodySm.Semibold"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
