<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/bottom_sheet_subway_timetable"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_rounded">
    <FrameLayout
        android:id="@+id/bottom_sheet_subway_timetable_view"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/bottom_sheet_subway_timetable_handle"
            android:layout_width="60dp"
            android:layout_height="5dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_bottom_sheet_handle_large" />
    </FrameLayout>

    <TextView
        android:id="@+id/bottom_sheet_subway_timetable_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="서초역 2호선"
        app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/TextAppearance.App.BodyMd.SemiBold"
        android:textColor="@color/text_primary"/>
    <LinearLayout
        android:id="@+id/bottom_sheet_subway_timetable_tab_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_tv">
        <LinearLayout
            android:id="@+id/bottom_sheet_subway_timetable_weekday_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true">
            <TextView
                android:id="@+id/bottom_sheet_subway_timetable_weekday_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="평일"
                android:textColor="@color/primary_500"
                style="@style/TextAppearance.App.BodySm.Semibold"
                android:layout_gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>
            <View
                android:id="@+id/bottom_sheet_subway_timetable_weekday_view"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/primary_500"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/bottom_sheet_subway_timetable_saturday_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true">
            <TextView
                android:id="@+id/bottom_sheet_subway_timetable_saturday_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="토요일"
                android:textColor="@color/gray_500"
                style="@style/TextAppearance.App.BodySm.Regular"
                android:layout_gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>
            <View
                android:id="@+id/bottom_sheet_subway_timetable_saturday_view"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_400"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/bottom_sheet_subway_timetable_holiday_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true">
            <TextView
                android:id="@+id/bottom_sheet_subway_timetable_holiday_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="공휴일"
                android:textColor="@color/gray_500"
                style="@style/TextAppearance.App.BodySm.Regular"
                android:layout_gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>
            <View
                android:id="@+id/bottom_sheet_subway_timetable_holiday_view"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_400"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/bottom_sheet_subway_timetable_whole_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="전체"
        style="@style/TextAppearance.App.BodySm.Semibold"
        android:textColor="@color/white"
        android:background="@drawable/btn_subway_timetable_selected"
        android:clickable="true"
        android:paddingTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_tab_ll"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/bottom_sheet_subway_timetable_first_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="첫차"
        style="@style/TextAppearance.App.BodySm.Regular"
        android:textColor="@color/gray_500"
        android:background="@drawable/btn_subway_timetable_unselected"
        android:clickable="true"
        android:paddingTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_tab_ll"
        app:layout_constraintStart_toEndOf="@id/bottom_sheet_subway_timetable_whole_tv"/>
    <TextView
        android:id="@+id/bottom_sheet_subway_timetable_last_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="막차"
        style="@style/TextAppearance.App.BodySm.Regular"
        android:textColor="@color/gray_500"
        android:background="@drawable/btn_subway_timetable_unselected"
        android:clickable="true"
        android:paddingTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_tab_ll"
        app:layout_constraintStart_toEndOf="@id/bottom_sheet_subway_timetable_first_tv"/>
    <LinearLayout
        android:id="@+id/bottom_sheet_subway_timetable_direction_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_last_tv"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_subway_timetable_gray">
            <TextView
                android:id="@+id/bottom_sheet_subway_timetable_down_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="교대 방면"
                android:textColor="@color/text_primary"
                style="@style/TextAppearance.App.BodySm.Medium"
                android:layout_gravity="center" />
            <TextView
                android:id="@+id/bottom_sheet_subway_timetable_down_sub_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="외선 순환/삼성/성수"
                android:textColor="@color/text_secondary"
                style="@style/TextAppearance.App.CaptionLg.Regular"
                android:layout_gravity="center"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_subway_timetable_gray">
            <TextView
                android:id="@+id/bottom_sheet_subway_timetable_up_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="방배 방면"
                android:textColor="@color/text_primary"
                style="@style/TextAppearance.App.BodySm.Medium"
                android:layout_gravity="center"/>
            <TextView
                android:id="@+id/bottom_sheet_subway_timetable_up_sub_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="내선 순환/서울대입구/성..."
                android:textColor="@color/text_secondary"
                style="@style/TextAppearance.App.CaptionLg.Regular"
                android:layout_gravity="center"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/bottom_sheet_subway_timetable_nsv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_direction_ll"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/bottom_sheet_subway_timetable_first_time_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☀ 첫차"
                android:textColor="@color/text_primary"
                style="@style/TextAppearance.App.BodySm.Medium"
                android:background="@drawable/bg_subway_timetable_gray"
                android:paddingTop="10dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="10dp"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:id="@+id/bottom_sheet_subway_timetable_first_time_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_first_time_tv">
                <LinearLayout
                    android:id="@+id/bottom_sheet_subway_timetable_first_down_ll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" />
                <LinearLayout
                    android:id="@+id/bottom_sheet_subway_timetable_first_up_ll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" />
            </LinearLayout>
            <TextView
                android:id="@+id/bottom_sheet_subway_timetable_last_time_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☾ 막차"
                android:textColor="@color/text_primary"
                style="@style/TextAppearance.App.BodySm.Medium"
                android:background="@drawable/bg_subway_timetable_gray"
                android:paddingTop="10dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="10dp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_first_time_ll"/>
            <LinearLayout
                android:id="@+id/bottom_sheet_subway_timetable_last_time_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/bottom_sheet_subway_timetable_last_time_tv">
                <LinearLayout
                    android:id="@+id/bottom_sheet_subway_timetable_last_down_ll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" />
                <LinearLayout
                    android:id="@+id/bottom_sheet_subway_timetable_last_up_ll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
