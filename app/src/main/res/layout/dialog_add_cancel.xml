<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_add_schedule_dialog"
    android:paddingTop="30dp"
    android:paddingBottom="30dp">
    <TextView
        android:id="@+id/dialog_delete_route_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="변경 사항이 저장되지 않았습니다.\n계속 진행하시겠습니까?"
        android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
        style="@style/TextColor.Primary"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/add_cancel_cancel_btn"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:text="취소"
        android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
        style="@style/TextColor.Primary"
        android:background="@drawable/bg_add_schedule_dialog_cancel"
        android:stateListAnimator="@null"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_delete_route_tv"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/add_cancel_confirm_btn"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:text="확인"
        android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
        style="@style/TextColor.White"
        android:background="@drawable/bg_add_schedule_dialog_confirm"
        android:stateListAnimator="@null"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_delete_route_tv"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>