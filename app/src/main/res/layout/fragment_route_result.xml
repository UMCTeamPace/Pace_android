<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <HorizontalScrollView
        android:id="@+id/route_chip_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="0dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/route_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recent_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="전체"
                android:textColor="@color/selector_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                app:chipCornerRadius="18dp"
                app:chipMinHeight="36dp"
                app:chipStrokeColor="@color/selector_chip_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recent_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="버스"
                android:textColor="@color/selector_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                app:chipCornerRadius="18dp"
                app:chipMinHeight="36dp"
                app:chipStrokeColor="@color/selector_chip_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recent_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="지하철"
                android:textColor="@color/selector_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                app:chipCornerRadius="18dp"
                app:chipMinHeight="36dp"
                app:chipStrokeColor="@color/selector_chip_text" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_location_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/route_chip_scroll_view"
        app:layout_constraintBottom_toBottomOf="parent"/>

