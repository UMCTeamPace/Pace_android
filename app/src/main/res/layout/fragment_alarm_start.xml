<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:clickable="true"      android:focusable="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/alarm_start_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="@drawable/ic_arrow_opened"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="출발 알림"
            android:textAppearance="@style/TextAppearance.App.HeadlineSm"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alarm_start_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/box_schedule"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/layout_checkbox_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_none"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="안함"
                            android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                            android:textColor="@color/text_primary" />

                        <CheckBox
                            android:id="@+id/cb_none"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:button="@null"
                            android:background="@drawable/selector_circle_checkbox"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200" />

                    <LinearLayout
                        android:id="@+id/layout_starttime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_starttime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="출발시각"
                            android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                            android:textColor="@color/text_primary" />

                        <CheckBox
                            android:id="@+id/cb_starttime"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:button="@null"
                            android:background="@drawable/selector_circle_checkbox"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                    <View android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200" />


                    <LinearLayout
                        android:id="@+id/layout_start5mago"
