<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/modal_title_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/schedule_category_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:padding="4dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_schedule_category"/>
        <TextView
            android:id="@+id/schedule_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="일정 제목"
            android:textAppearance="@style/TextAppearance.App.HeadlineSm"
            style="@style/TextColor.Primary"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/modal_time_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/modal_title_ll"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_time"/>
        <TextView
            android:id="@+id/modal_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="하루 종일"
            android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
            style="@style/TextColor.Secondary"
            android:layout_marginStart="4dp" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/modal_repeat_iv"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_repeat_modal"
            android:layout_gravity="center"/>
        <TextView
            android:id="@+id/modal_repeat_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="매주 금요일"
            android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
            style="@style/TextColor.Secondary"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modal_normal_location_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modal_time_ll">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_route_unselected" />
        <TextView
            android:id="@+id/modal_normal_location_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="장소"
            android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
            style="@style/TextColor.Secondary"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modal_route_location_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:background="@drawable/box_modal_reminder"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modal_time_ll">

        <LinearLayout
            android:id="@+id/modal_route_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/modal_route_location_iv"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_route_schedule" />
            <TextView
                android:id="@+id/modal_route_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="장소1 --> 장소2"
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
                style="@style/TextColor.Primary"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/modal_route_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="00:00 - 00:00"
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
                style="@style/TextColor.Secondary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
                android:layout_marginStart="8dp"
                style="@style/TextColor.Tertiary"/>
            <TextView
                android:id="@+id/modal_total_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0시간 0분"
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
                android:layout_marginStart="8dp"
                style="@style/TextColor.Secondary"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/modal_route_brief_view"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_item_route_detail_brief"
        app:layout_constraintTop_toBottomOf="@id/modal_route_location_ll"/>
    <LinearLayout
        android:id="@+id/modal_route_brief_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/modal_route_location_ll"/>
    <LinearLayout
        android:id="@+id/modal_route_vehicle_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/modal_route_brief_ll"/>
    <TextView
        android:id="@+id/modal_memo_tv"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="메모"
        android:background="@drawable/box_modal_memo"
        style="@style/TextColor.Secondary"
        android:paddingTop="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="44dp"
        app:layout_constraintTop_toBottomOf="@id/modal_route_vehicle_ll"/>
    <LinearLayout
        android:id="@+id/modal_reminder_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:background="@drawable/box_modal_reminder"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modal_memo_tv">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/modal_schedule_reminder_iv"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_modal_schedule" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="일정 알림"
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
                style="@style/TextColor.Secondary"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/modal_schedule_reminder_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="10분 전, 1시간 전, ..."
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
                style="@style/TextColor.Primary"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_vertical">
            <ImageView
                android:id="@+id/modal_departure_reminder_iv"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_modal_departure" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="출발 알림"
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
                style="@style/TextColor.Secondary"/>

            <View
                android:layout_width="208dp"
                android:layout_height="4dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/modal_departure_reminder_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5분 전, 15분 전, ..."
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
                style="@style/TextColor.Primary"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>