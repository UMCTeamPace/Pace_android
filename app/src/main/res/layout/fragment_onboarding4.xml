<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <View
        android:id="@+id/centerLine"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="@color/primary_400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <ImageView
        android:id="@+id/ic_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="-9.5dp"
        android:src="@drawable/ic_onboarding_clock"
        app:layout_constraintBottom_toTopOf="@+id/centerLine"
        app:layout_constraintEnd_toStartOf="@+id/ic_map"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ic_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="-9.5dp"
        android:src="@drawable/ic_onboarding_map_pin"
        app:layout_constraintBottom_toTopOf="@+id/centerLine"
        app:layout_constraintEnd_toStartOf="@+id/ic_calendar"
        app:layout_constraintStart_toEndOf="@+id/ic_clock" />

    <ImageView
        android:id="@+id/ic_calendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-9.5dp"
        android:src="@drawable/ic_onboarding_calendar"
        app:layout_constraintBottom_toTopOf="@+id/centerLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ic_map" />
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        tools:text="이제는 일정과 경로를 하나로\n출발까지의 흐름을 Pace가 이어드려요."
        android:textAppearance="@style/TextAppearance.App.BodyMd.Regular"
        android:textColor="@color/text_primary"
        android:lineSpacingExtra="4dp"
        android:alpha="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/centerLine" />

</androidx.constraintlayout.widget.ConstraintLayout>
