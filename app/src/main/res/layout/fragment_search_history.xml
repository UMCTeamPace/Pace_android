<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/layout_route_options"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/frame_my_location"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/btn_my_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_my_location2"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="내 위치"
                    android:fontFamily="@font/pretendard_medium"
                    android:textColor="@color/primary_500"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frame_select_on_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/btn_select_on_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_map"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="지도에서 선택"
                    android:fontFamily="@font/pretendard_medium"
                    android:textColor="@color/gray_600"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    
    <HorizontalScrollView
        android:id="@+id/search_chip_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_route_options">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recent_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근검색"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"
                android:checked="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recent_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근장소"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recent_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근경로"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_saved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저장됨"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_route_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="경로히스토리"
                app:chipMinHeight="36dp"
                app:chipCornerRadius="18dp"
                android:checkable="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_background"
                android:textColor="@color/selector_chip_text"
                app:chipStrokeColor="@color/selector_chip_text"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_location_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/search_chip_scroll_view"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>