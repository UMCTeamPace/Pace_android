<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:clickable="true"      android:focusable="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/alarm_schedule_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="@drawable/ic_arrow_opened"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일정 알림"
            android:textAppearance="@style/TextAppearance.App.HeadlineSm"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alarm_schedule_toolbar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/box_schedule"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/layout_checkbox_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="?attr/selectableItemBackground">

                <TextView
                android:id="@+id/tv_none"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="안함"
                android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_none"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_starttime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_starttime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="일정 시작 시간"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_starttime"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_start5mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_start5mago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5분 전"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_start5mago"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_start10mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_start10mago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="10분 전"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_start10mago"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_start15mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_start15mago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15분 전"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_start15mago"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_start30mago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:layout_marginVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_start30mago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="30분 전"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_start30mago"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_start1hago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_start1hago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1시간 전"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_start1hago"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_start2hago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_start2hago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2시간 전"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_start2hago"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_start1dago"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_start1dago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1일 전"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_start1dago"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_start2dago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:layout_marginVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_start2dago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2일 전"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_start2dago"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200" />

            <LinearLayout
                android:id="@+id/layout_start1wago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_start1wago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1주 전"
                    android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_start1wago"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:button="@null"
                    android:background="@drawable/selector_circle_checkbox"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_alarm_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="*알림은 총 5개 까지 설정할 수 있습니다."
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.BodySm.Semibold"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>