<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_undo_snackbar"
    android:minHeight="40dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingVertical="4dp"
        android:text="삭제되었습니다."
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
        android:textColor="@color/gray_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layout_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="4dp"
            android:background="@drawable/bg_undo_snackbar_cancel"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="24dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="취소"
            android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
            android:textColor="@color/gray_0" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/bg_undo_snackbar_close"
            app:tint="@color/gray_0" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
