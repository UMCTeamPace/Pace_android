<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="324dp"
    android:layout_height="510dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/box_modal_case"
    android:clickable="true"
    android:paddingTop="24dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">
    <TextView
        android:id="@+id/modal_case_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2026년 2월 20일 금요일"
        android:textAppearance="@style/TextAppearance.App.CaptionLg.Regular"
        style="@style/TextColor.Secondary"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/modal_case_vp"
        android:layout_width="276dp"
        android:layout_height="406dp"
        android:clickable="true"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/modal_case_tv"
        app:layout_constraintStart_toStartOf="parent"/>
    <me.relex.circleindicator.CircleIndicator3
        android:id="@+id/modal_case_ci"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ci_width="23.89dp"
        app:ci_height="5.92dp"
        app:ci_margin="0dp"
        app:ci_drawable_unselected="@drawable/ic_modal_unselected"
        app:ci_drawable="@drawable/ic_modal_selected"
        app:ci_animator="@animator/modal_case_animator"
        android:clickable="true"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/modal_case_vp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>