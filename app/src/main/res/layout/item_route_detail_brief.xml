<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">
    <TextView
        android:id="@+id/item_route_detail_brief_tv"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:text="50분"
        android:textAppearance="@style/TextAppearance.App.CaptionSm.Medium"
        style="@style/TextColor.White"
        android:background="@drawable/bg_item_route_detail_brief"
        android:gravity="center"
        android:paddingStart="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />
    <ImageView
        android:id="@+id/item_route_detail_brief_iv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_route_detail" />
</FrameLayout>
