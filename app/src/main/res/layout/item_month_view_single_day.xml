<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_month_view_single_day"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingBottom="4dp"
    app:layout_constraintTop_toBottomOf="@id/calendarDayText"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">
    <View
        android:id="@+id/item_month_view_single_color"
        android:layout_width="4dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_item_month_view" />
    <TextView
        android:id="@+id/item_month_view_single_tv"
        android:layout_width="34dp"
        android:layout_height="10dp"
        android:text="일정"
        android:textAppearance="@style/TextAppearance.App.CaptionSm.Medium"
        style="@style/TextColor.Primary"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="3dp"
        android:maxLines="1"
        android:ellipsize="end"/>
</LinearLayout>