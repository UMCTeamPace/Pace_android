<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:elevation="20dp">

    <include
        android:id="@+id/layout_map_select_header"
        layout="@layout/layout_map_select_header"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tv_map_instruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#65191914"
        android:gravity="center"
        android:padding="8dp"
        android:text="지도를 움직여 위치를 지정하세요."
        android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/layout_map_select_header" />

    <ImageView
        android:id="@+id/iv_center_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_my_location_pin"
        android:layout_marginBottom="35dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btn_go_my_location_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:elevation="6dp"
        android:src="@drawable/ic_my_location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cv_map_address_card" />

    <LinearLayout
        android:id="@+id/cv_map_address_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_rounded"
        android:elevation="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="34dp">

            <FrameLayout
                android:id="@+id/layout_drag_handle_area"
                android:layout_width="match_parent"
                android:layout_height="32dp">

                <View
                    android:id="@+id/view_handle"
                    android:layout_width="60dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_bottom_sheet_handle_large" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_map_select_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="주소를 불러오는 중..."
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textAppearance="@style/TextAppearance.App.BodyMd.Medium" />

            <TextView
                android:id="@+id/tv_map_select_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:singleLine="true"
                android:text="위치 정보 확인 중"
                android:textColor="@color/text_tertiary"
                android:textAppearance="@style/TextAppearance.App.CaptionLg.Medium"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_map_select_confirm"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_map_select_confirm_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="확인"
                android:backgroundTint="@color/primary_500"
                android:textAppearance="@style/TextAppearance.App.BodySm.Regular"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
